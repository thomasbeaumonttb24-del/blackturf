# ============================================================
# BlackTurf — Variables d'environnement
# Copier en .env et remplir toutes les valeurs
# ============================================================

# --- Base de données ---
POSTGRES_USER=blackturf
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=blackturf
DATABASE_URL=postgresql+asyncpg://blackturf:CHANGE_ME@localhost:5432/blackturf
# URL sync (pour Alembic migrations)
DATABASE_URL_SYNC=postgresql://blackturf:CHANGE_ME@localhost:5432/blackturf

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# --- Sécurité JWT ---
# Générer avec: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Anthropic (Claude API) ---
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# --- Stripe ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# IDs des produits Stripe (créer dans le dashboard)
STRIPE_PRICE_STARTER_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_STARTER_ANNUAL=price_CHANGE_ME
STRIPE_PRICE_PRO_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_PRO_ANNUAL=price_CHANGE_ME

# --- Emails (Resend) ---
# https://resend.com
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=noreply@blackturf.fr
EMAIL_FROM_NAME=BlackTurf

# --- Météo ---
# https://openweathermap.org/api
OPENWEATHER_API_KEY=CHANGE_ME

# --- Proxy scraping (BrightData) ---
# https://brightdata.com
BRIGHTDATA_PROXY=http://user:pass@zproxy.lum-superproxy.io:22225

# --- Web Push (VAPID) ---
# Générer avec: npx web-push generate-vapid-keys
# VIDES = canal push MORT, en silence (0 livraison sur 22 349 de juin à août 2026).
# La clé PUBLIQUE alimente aussi le build du frontend : docker-compose.prod.yml
# la passe en `NEXT_PUBLIC_VAPID_PUBLIC_KEY` depuis CETTE variable — une seule
# source, pour qu'elles ne puissent pas diverger.
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@blackturf.fr

# --- Application ---
ENVIRONMENT=production
FRONTEND_URL=https://blackturf.fr
API_URL=https://api.blackturf.fr
ALLOWED_ORIGINS=https://blackturf.fr,https://www.blackturf.fr

# --- Scraper ---
SCRAPER_INTERVAL=5
PMU_API_BASE=https://offline.turfinfo.api.pmu.fr/rest/client/7
GENY_BASE_URL=https://www.geny.com

# --- ML ---
MODELS_PATH=./models
MODEL_MIN_AUC=0.60
RETRAIN_HOUR_UTC=2
RETRAIN_EVERY_N_RESULTS=20

# --- Monitoring ---
SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
PROMETHEUS_PORT=9090

# --- Admin ---
ADMIN_EMAIL=admin@blackturf.fr

# ── Role applicatif PostgreSQL ────────────────────────────────────────────────
# L'application NE se connecte PAS avec POSTGRES_USER. Ce role-la est le role
# bootstrap de PostgreSQL : le moteur REFUSE de lui retirer l'attribut
# superutilisateur, et un superutilisateur peut lancer des commandes shell via
# COPY ... TO PROGRAM. La moindre injection SQL vaudrait donc execution de code.
#
# bt_app herite des privileges de proprietaire de POSTGRES_USER — tout marche,
# y compris les tables creees a l'execution, les CREATE INDEX et les migrations
# alembic — mais n'herite pas de l'attribut superutilisateur, et son GRANT porte
# SET FALSE : il ne peut pas y basculer.
#
#   CREATE ROLE bt_app LOGIN INHERIT PASSWORD '<40 caracteres aleatoires>';
#   GRANT <POSTGRES_USER> TO bt_app WITH INHERIT TRUE, SET FALSE;
#
# Seule limite connue : CREATE EXTENSION exige le superutilisateur. Une future
# migration qui en ajouterait une doit etre passee avec POSTGRES_USER.
APP_DB_USER=bt_app
APP_DB_PASSWORD=change-moi
