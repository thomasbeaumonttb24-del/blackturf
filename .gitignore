# Environment — NEVER commit
.env
.env.*
!.env.production.template
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
*.cover

# ML models (large binaries)
backend/models/*.pkl
backend/models/*.joblib
backend/models/*.cbm
backend/models/*.json
!backend/models/.gitkeep

# Next.js
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Docker volumes (local dev)
postgres_data/
redis_data/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Playwright
backend/scraper/.auth/
playwright-report/
test-results/

# Logs
*.log
logs/

# Artefacts entraînement
catboost_info/
backend/catboost_info/
*.log
nginx/nginx.runtime.conf

# deploy backups / snapshots (never commit)
*.bak
*.bak.*
backups/
*.sql.gz

# backup snapshots / regressed copies (never commit) — audit 2026-07-21
*.localbak
*.bak2*
*.bak-*
_backup_*/
_predeploy_backup/
_orig_bak/
cleanup_dups.sql
# build cache, never version
frontend/tsconfig.tsbuildinfo

# Copies de sauvegarde du .env de production (contiennent des secrets reels)
_backup_*_env_*

# Bundles de deploiement (tar du code a un commit donne, ~8 Mo) : artefact de
# build, reconstructible depuis git. Les versionner alourdirait l'historique
# definitivement, meme apres suppression.
blackturf-deploy-*.tar

# Certificat PUBLIC de chiffrement des sauvegardes. Non secret, mais propre a
# CETTE installation : il est la moitie publique de la cle privee detenue par
# l exploitant, hors serveur. Le suivre en git lierait le depot a une paire de
# cles precise. Son absence fait ECHOUER db_backup.sh volontairement, plutot que
# de produire un dump en clair — echec ferme, jamais de repli silencieux.
.backup-cert.pem

# Journaux nginx persistants (montes dans le conteneur) — jamais versionnes.
nginx/logs/*
!nginx/logs/.gitkeep
